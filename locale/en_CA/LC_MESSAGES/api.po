#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/utilities/points.pydocstring
#: of pyvista.core.utilities.points.principal_axes:4
msgid ""
"Principal axes are orthonormal vectors that best fit a set of points. The "
"axes are also known as the principal components in Principal Component "
"Analysis (PCA), or the right singular vectors from the Singular Value "
"Decomposition (SVD)."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/utilities/points.pydocstring
#: of pyvista.core.utilities.points.principal_axes:8
msgid ""
"The axes are computed as the eigenvectors of the covariance matrix from the "
"mean-centered points, and are processed to ensure that they form a right-"
"handed coordinate frame."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/utilities/points.pydocstring
#: of pyvista.core.utilities.points.principal_axes:12
msgid ""
"The axes explain the total variance of the points. The first axis explains "
"the largest percentage of variance, followed by the second axis, followed "
"again by the third axis which explains the smallest percentage of variance."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/utilities/points.pydocstring
#: of pyvista.core.utilities.points.principal_axes:16
msgid ""
"The axes may be used to build an oriented bounding box or to align the "
"points to another set of axes (e.g. the world XYZ axes)."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/utilities/points.pydocstring
#: of pyvista.core.utilities.points.principal_axes:20
msgid ""
"The computed axes are not unique, and the sign of each axis direction can be"
