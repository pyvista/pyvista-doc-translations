#: of pyvista.ImageData.user_dict:8
msgid ""
"Since the user dict is stored as field data, it is automatically saved with "
"the mesh when it is saved in a compatible file format (e.g. ``'.vtk'``). Any"
" saved metadata is automatically de-serialized by PyVista whenever the user "
"dict is accessed again. Since the data is stored as JSON, it may also be "
"easily retrieved or read by other programs."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/dataobject.pydocstring
#: of pyvista.DataObject.user_dict:14
