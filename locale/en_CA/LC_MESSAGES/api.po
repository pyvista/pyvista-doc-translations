msgid ""
"Concatenation mode to use. This determines how images are placed in the "
"output. All modes operate along the specified ``axis`` except for "
"``'preserve-extents'``. Specify one of:"
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.concatenate:37
msgid ""
"``'strict'``: all images must have identical dimensions except along the "
"specified ``axis``."
