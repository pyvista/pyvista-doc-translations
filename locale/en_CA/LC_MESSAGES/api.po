msgid ""
"The dictionary is stored as a JSON-serialized string as part of the mesh's "
"field data. Unlike regular field data, which requires values to be stored as"
" an array, the user dict provides a mapping for scalar values."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/dataobject.pydocstring
#: of pyvista.DataObject.user_dict:8
