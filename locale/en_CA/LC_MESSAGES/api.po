#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:60
msgid ""
"**select_inputs** : :class:`python:int` | "
":obj:`VectorLike`\\[:class:`python:int`], default: :data:`python:None`"
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:59
