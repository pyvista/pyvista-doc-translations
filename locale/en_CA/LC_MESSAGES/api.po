msgid ""
"This filter uses :vtk:`vtkSurfaceNets3D` to extract polygonal surface "
"contours from non-continuous label maps, which corresponds to discrete "
"regions in an input 3D image (i.e., volume). It is designed to generate "
"surfaces from image point data, e.g. voxel point samples from 3D medical "
"images, though images with cell data are also supported."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:10
msgid ""
"The generated surface is smoothed using a constrained smoothing filter, "
"which may be fine-tuned to control the smoothing process. Optionally, "
"smoothing may be disabled to generate a staircase-like surface."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:14
