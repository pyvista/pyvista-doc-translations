#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:4
msgid ""
"This filter uses :vtk:`vtkSurfaceNets3D` to extract polygonal surface "
"contours from non-continuous label maps, which corresponds to discrete "
"regions in an input 3D image (i.e., volume). It is designed to generate "
"surfaces from image point data, e.g. voxel point samples from 3D medical "
"images, though images with cell data are also supported."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:10
msgid ""
"The generated surface is smoothed using a constrained smoothing filter, "
"which may be fine-tuned to control the smoothing process. Optionally, "
"smoothing may be disabled to generate a staircase-like surface."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:14
msgid ""
"The output surface includes a two-component cell data array "
"``'boundary_labels'``. The array indicates the labels/regions on either side"
" of the polygons composing the output. The array's values are structured as "
"follows:"
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:18
msgid "External boundary values"
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:20
msgid ""
"Polygons between a foreground region and the background have the form "
"``[foreground, background]``."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:23
msgid ""
"E.g. ``[1, 0]`` for the boundary between region ``1`` and background ``0``."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:25
msgid "Internal boundary values"
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:27
msgid ""
"Polygons between two connected foreground regions are sorted in ascending "
"order."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:29
msgid "E.g. ``[1, 2]`` for the boundary between regions ``1`` and ``2``."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:31
msgid ""
"By default, this filter returns ``'external'`` contours only. Optionally, "
"only the ``'internal'`` contours or ``'all'`` contours (i.e. internal and "
"external) may be returned."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:39
msgid "**boundary_style**"
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels-1
msgid ""
"'external' | 'internal' | 'all' | 'strict_external', default: 'external'"
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:40
msgid ""
"Style of boundary polygons to generate. ``'internal'`` polygons are "
"generated between two connected foreground regions. ``'external'`` polygons "
"are generated between foreground and background regions. ``'all'``  includes"
" both internal and external boundary polygons."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:45
msgid ""
"These styles are generated such that ``internal + external = all``. "
"Internally, the filter computes all boundary polygons by default and then "
"removes any undesired polygons in post-processing. This improves the quality"
" of the output, but can negatively affect the filter's performance since all"
" boundaries are always initially computed."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:51
msgid ""
"The ``'strict_external'`` style can be used as a fast alternative to "
"``'external'``. This style `strictly` generates external polygons and does "
"not compute or consider internal boundaries. This computation is fast, but "
"also results in jagged, non-smooth boundaries between regions."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:57
msgid ""
"Background value of the input image. All other values are considered as "
"foreground."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:60
msgid ""
"**select_inputs** : :class:`python:int` | "
":obj:`VectorLike`\\[:class:`python:int`], default: :data:`python:None`"
msgstr ""
"**select_inputs** : :class:`python:int` | "
":obj:`VectorLike`\\[:class:`python:int`], default: :data:`python:None`"

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:59
