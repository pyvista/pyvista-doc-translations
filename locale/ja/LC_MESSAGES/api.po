#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:77
msgid "python:int | VectorLike[python:int], default: python:None"
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:61
msgid ""
"Specify label ids to include as inputs to the filter. Labels that are not "
"selected are removed from the input *before* generating the surface. By "
"default, all label ids are used."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:65
msgid ""
"Since the smoothing operation occurs across selected input regions, using "
"this option to filter the input can result in smoother and more visually "
"pleasing surfaces since non-selected inputs are not considered during "
"smoothing. However, this also means that the generated surface will change "
"shape depending on which inputs are selected."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:73
msgid ""
"Selecting inputs can affect whether a boundary polygon is considered to be "
"``internal`` or ``external``. That is, an internal boundary becomes an "
"external boundary when only one of the two foreground regions on the "
"boundary is selected."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:78
msgid ""
"**select_outputs** : :class:`python:int` | "
":obj:`VectorLike`\\[:class:`python:int`], default: :data:`python:None`"
msgstr ""
"**select_outputs** : :class:`python:int` | "
":obj:`VectorLike`\\[:class:`python:int`], default: :data:`python:None`"

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:79
msgid ""
"Specify label ids to include in the output of the filter. Labels that are "
"not selected are removed from the output *after* generating the surface. By "
"default, all label ids are used."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:83
msgid ""
"Since the smoothing operation occurs across all input regions, using this "
"option to filter the output means that the selected output regions will have"
" the same shape (i.e. smoothed in the same manner), regardless of the "
"outputs that are selected. This is useful for generating a surface for "
"specific labels while also preserving sharp boundaries with non-selected "
"outputs."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:91
msgid ""
"Selecting outputs does not affect whether a boundary polygon is considered "
"to be ``internal`` or ``external``. That is, an internal boundary remains "
"internal even if only one of the two foreground regions on the boundary is "
"selected."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:96
msgid ""
"**pad_background** : :ref:`bool <python:bltin-boolean-values>`, default: "
":data:`python:True`"
msgstr ""
"**pad_background** : :ref:`bool <python:bltin-boolean-values>`, default: "
":data:`python:True`"

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:97
msgid ""
":meth:`Pad <pyvista.ImageDataFilters.pad_image>` the image with "
"``background_value`` prior to contouring. This will generate polygons to "
"\"close\" the surface at the boundaries of the image. This option is only "
"relevant when there are foreground regions on the border of the image. "
"Setting this value to ``False`` is useful if processing multiple volumes "
"separately so that the generated surfaces fit together without creating "
"surface overlap."
msgstr ""

#: ../../../../../../../opt/hostedtoolcache/Python/3.13.14/x64/lib/python3.13/site-packages/pyvista/core/filters/image_data.pydocstring
#: of pyvista.core.filters.image_data.ImageDataFilters.contour_labels:105
msgid ""
"**output_mesh_type** : :class:`python:str`, default: :data:`python:None`"
msgstr ""

