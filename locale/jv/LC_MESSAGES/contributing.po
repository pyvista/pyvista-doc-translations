msgstr ""

#: ../../pyvista/CONTRIBUTING.rst:2269
msgid "Storage: 256 GB SSD"
msgstr ""

#: ../../pyvista/CONTRIBUTING.rst:2270
msgid "Memory: 16 GB Unified Memory"
msgstr ""

#: ../../pyvista/CONTRIBUTING.rst:2271
msgid "OS: MacOS 15"
